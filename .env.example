# Homies Web & Vercel Environment Variables
PORT=3000

# Required admin login password; set privately in Vercel Environment Variables
ADMIN_PASSWORD=replace-with-a-long-unique-password

# MongoDB Connection String (Atlas / Cloud MongoDB)
# Supported variable names in Vercel or locally: MONGODB_URI, MONGO_URI, DATABASE_URL, MONGODB_URL
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/homies?retryWrites=true&w=majority
